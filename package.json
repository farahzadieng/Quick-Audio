{
  "name": "quick-audio-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first audio tag editor and audio converter that runs on your device.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "postinstall": "node scripts/copy-ffmpeg.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "fflate": "^0.8.3",
    "lucide-react": "0.468.0",
    "music-metadata": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.4.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
